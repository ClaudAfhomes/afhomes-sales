{
  "expo": {
    "name": "AFhomes Staff POS",
    "slug": "afhomes-staff-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.afhomes.staff"
    },
    "android": {
      "package": "com.afhomes.staff",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      ["expo-camera", {"cameraPermission": "Allow AFhomes Staff POS to scan VIP card QR codes."}],
      ["react-native-nfc-manager", {"nfcPermission": "Allow AFhomes Staff POS to read VIP membership cards."}]
    ]
  }
}
